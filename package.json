{
  "name": "motion-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "remotion:studio": "remotion studio remotion/index.ts",
    "render": "remotion render remotion/index.ts Intro out/intro.mp4 --codec=h264",
    "render:signspath": "remotion render remotion/index.ts SignsPath out/signspath.mp4 --codec=h264 --audio-codec=aac",
    "sfx:signspath": "python3 scripts/generate_sfx.py",
    "render:viewz": "remotion render remotion/index.ts ViewZ out/viewz.mp4 --codec=h264 --audio-codec=aac",
    "sfx:viewz": "python3 scripts/generate_sfx_viewz.py",
    "render:viewz-casting": "remotion render remotion/index.ts ViewZCasting out/viewz-casting.mp4 --codec=h264 --audio-codec=aac",
    "render:viewz-partenaires": "remotion render remotion/index.ts ViewZPartenaires out/viewz-partenaires.mp4 --codec=h264 --audio-codec=aac",
    "sfx:viewz-b2b": "python3 scripts/generate_sfx_viewz_b2b.py",
    "render:stride": "remotion render remotion/index.ts Stride out/stride.mp4 --codec=h264 --audio-codec=aac",
    "sfx:stride": "python3 scripts/generate_sfx_stride.py",
    "render:nova": "remotion render remotion/index.ts NovaVertical out/nova-9x16.mp4 --codec=h264 --audio-codec=aac && remotion render remotion/index.ts NovaWide out/nova-16x9.mp4 --codec=h264 --audio-codec=aac",
    "sfx:nova": "python3 scripts/generate_sfx_nova.py",
    "render:atlas": "remotion render remotion/index.ts AtlasVertical out/atlas-9x16.mp4 --codec=h264 --audio-codec=aac && remotion render remotion/index.ts AtlasWide out/atlas-16x9.mp4 --codec=h264 --audio-codec=aac",
    "sfx:atlas": "python3 scripts/generate_sfx_atlas.py",
    "render:signspath-ritual": "remotion render remotion/index.ts SignsPathRitual out/signspath-ritual.mp4 --codec=h264 --audio-codec=aac",
    "render:launch": "remotion render remotion/index.ts LaunchVertical out/launch-9x16.mp4 --codec=h264 --audio-codec=aac && remotion render remotion/index.ts LaunchWide out/launch-16x9.mp4 --codec=h264 --audio-codec=aac",
    "sfx:launch": "python3 scripts/generate_sfx_launch.py",
    "render:probsol": "remotion render remotion/index.ts ProblemSolution out/probleme-solution.mp4 --codec=h264 --audio-codec=aac",
    "sfx:probsol": "python3 scripts/generate_sfx_probsol.py",
    "render:proof": "remotion render remotion/index.ts SocialProof out/social-proof.mp4 --codec=h264 --audio-codec=aac",
    "sfx:proof": "python3 scripts/generate_sfx_proof.py",
    "render:webbuild": "remotion render remotion/index.ts WebBuild out/web-build.mp4 --codec=h264 --audio-codec=aac",
    "sfx:webbuild": "python3 scripts/generate_sfx_webbuild.py",
    "render:demo": "remotion render remotion/index.ts ProductDemo out/product-demo.mp4 --codec=h264 --audio-codec=aac",
    "sfx:demo": "python3 scripts/generate_sfx_demo.py",
    "render:terminal": "remotion render remotion/index.ts Terminal out/terminal.mp4 --codec=h264 --audio-codec=aac",
    "sfx:terminal": "python3 scripts/generate_sfx_terminal.py",
    "render:platforms": "remotion render remotion/index.ts Platforms out/platforms.mp4 --codec=h264 --audio-codec=aac",
    "sfx:platforms": "python3 scripts/generate_sfx_platforms.py",
    "render:browsertour": "remotion render remotion/index.ts BrowserTour out/browser-tour.mp4 --codec=h264 --audio-codec=aac",
    "sfx:browsertour": "python3 scripts/generate_sfx_browsertour.py",
    "render:kinetik2": "remotion render remotion/index.ts KinetikDay2 out/kinetik-day2.mp4 --codec=h264 --audio-codec=aac",
    "sfx:kinetik2": "python3 scripts/generate_sfx_kinetik2.py",
    "render:signspath-21days": "remotion render remotion/index.ts SignsPath21Days out/signspath-21days.mp4 --codec=h264 --audio-codec=aac",
    "render:signspath-tuesday": "remotion render remotion/index.ts SignsPathTuesday out/signspath-tuesday.mp4 --codec=h264 --audio-codec=aac",
    "render:signspath-eyes": "remotion render remotion/index.ts SignsPathEyesClosed out/signspath-eyes-closed.mp4 --codec=h264 --audio-codec=aac"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
